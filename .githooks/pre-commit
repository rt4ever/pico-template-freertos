#!/bin/bash
# Pre-commit hook: run clang-format on staged C sources
# Install:  git config core.hooksPath .githooks
#
# Submodule files are excluded automatically by reading .gitmodules.

set -e

CLANG_FORMAT=$(which clang-format 2>/dev/null || true)
if [ -z "$CLANG_FORMAT" ]; then
  echo "WARNING: clang-format not found — skipping format check"
  exit 0
fi

# Build a grep -v filter for all submodule paths from .gitmodules
GREP_EXCLUDE="\.pio\.h$"   # always exclude generated PIO headers
if [ -f .gitmodules ]; then
  while IFS= read -r line; do
    case "$line" in
      *"path = "*)
        path=$(echo "$line" | sed 's/.*path = //')
        GREP_EXCLUDE="$GREP_EXCLUDE|^$path/"
        ;;
    esac
  done < .gitmodules
fi

# Collect staged .c and .h files, excluding submodules and generated code
FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.c' '*.h' \
  | grep -v -E "$GREP_EXCLUDE")

if [ -z "$FILES" ]; then
  exit 0
fi

echo "Checking formatting..."
FAILED=0

for FILE in $FILES; do
  if [ ! -f "$FILE" ]; then
    continue
  fi
  $CLANG_FORMAT --dry-run --Werror "$FILE" 2>/dev/null
  if [ $? -ne 0 ]; then
    echo "  $FILE — would be reformatted"
    $CLANG_FORMAT --diff "$FILE"
    FAILED=1
  fi
done

if [ $FAILED -ne 0 ]; then
  echo ""
  echo "Commit rejected: some files need formatting."
  echo "Run: clang-format -i <file>"
  exit 1
fi

echo "Format check passed."
exit 0
