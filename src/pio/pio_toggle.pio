;
; PIO Toggle program — square-wave on GPIO27
;
; Drives GPIO27 with 50 % duty cycle. Clock divider set for ~1 Hz blink.
;
.program pio_toggle
    set pindirs, 1   ; set pin to output
.wrap_target
    set pins, 1      ; GPIO27 = high  [1 cycle]
    set pins, 0      ; GPIO27 = low   [1 cycle]
.wrap
% c-sdk {
static inline void pio_toggle_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = pio_toggle_program_get_default_config(offset);

    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_wrap(&c, offset + pio_toggle_wrap_target, offset + pio_toggle_wrap);

    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    sm_config_set_clkdiv(&c, 125000000.f / 2500000.f);

    pio_sm_init(pio, sm, offset, &c);
}
%}
